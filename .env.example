# AutoVid settings (env-overridable via AUTOVID_ prefix).
# Copy to `.env` and adjust as needed.

# Catalog root: SQLite DB, thumbnails, clips, renders (gitignored).
# AUTOVID_DATA_DIR=catalog

# ffmpeg/ffprobe folder if not on PATH and not in .tools/ffmpeg*/bin.
# AUTOVID_FFMPEG_DIR=C:/path/to/ffmpeg/bin

# Decision layer (DecisionMCP). auto = use it, fall back to heuristics if down.
AUTOVID_DECISIONMCP_URL=http://127.0.0.1:8765/mcp
AUTOVID_DECISION_MODE=auto

# Cloud VLM (OpenAI-compatible chat API with image input).
AUTOVID_VLM_BASE_URL=https://api.z.ai/api/paas/v4
AUTOVID_VLM_MODEL=glm-4.6v
AUTOVID_VLM_API_KEY=
AUTOVID_VLM_TIMEOUT_S=120
AUTOVID_VLM_MAX_RETRIES=2

# Baseline sampling policy (the decision layer refines these).
AUTOVID_GRID_INTERVAL_S=2.0
AUTOVID_THUMB_INTERVAL_S=30.0
AUTOVID_SCENE_THRESHOLD=0.3
